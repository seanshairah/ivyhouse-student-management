# ─────────────────────────────────────────────────────────────
# Ivy House Student Management System — Environment Variables
# Copy this file to `.env` and fill in real values.
# Never commit `.env` with real secrets.
# ─────────────────────────────────────────────────────────────

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ivy_house?schema=public"

# App
APP_URL="http://localhost:3000"

# Authentication (secure JWT session)
# REQUIRED. The app refuses to start in production without this — it will not
# fall back to a default secret, because a known secret lets anyone forge an
# owner session. Generate one with:  openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-secret-string"
NEXTAUTH_URL="http://localhost:3000"

# Email — Resend (primary provider)
RESEND_API_KEY=""
# Sender for ALL outgoing email. Must be an address on your Resend-verified
# domain. RESEND_FROM_EMAIL takes precedence over EMAIL_FROM (either works).
RESEND_FROM_EMAIL="Ivy Properties <notifications@ivyproperties.co.zw>"
EMAIL_FROM="Ivy Properties <notifications@ivyproperties.co.zw>"

# Email — SMTP (fallback provider)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"

# Bulk SMS — SMS Pop (primary provider, https://smspop.co.zw)
# Create a token in the SMS Pop dashboard under "API Tokens -> Create".
# SMSPOP_SENDER_ID must be an approved sender/brand ID on your account.
SMSPOP_API_KEY=""
SMSPOP_SENDER_ID=""
SMSPOP_BASE_URL="https://smspop.co.zw/api"

# Bulk SMS — generic adapter (optional fallback provider)
BULKSMS_API_KEY=""
BULKSMS_SENDER_ID="IvyHouse"
BULKSMS_BASE_URL="https://api.bulksms.example.com"

# Paynow payment gateway
PAYNOW_INTEGRATION_ID=""
PAYNOW_INTEGRATION_KEY=""
PAYNOW_RETURN_URL="http://localhost:3000/student/payments/return"
PAYNOW_RESULT_URL="http://localhost:3000/api/payments/paynow/result"
# development = mock payments (no real keys needed). Switch to "live" with real keys.
#
# WARNING: in development mode every payment is reported as PAID without any
# money moving. Production refuses to start unless PAYNOW_INTEGRATION_ID and
# PAYNOW_INTEGRATION_KEY are both set, so a missing key can never silently
# downgrade a live deployment into mock mode.
PAYNOW_MODE="development"
# The address Paynow sends its confirmation to, and validates on every remote
# (mobile-money) transaction.
#
# REQUIRED while the Paynow merchant account is in TEST mode: Paynow only
# accepts the merchant's own registered email then, and rejects anything else
# with "The authemail field is required for remote transactions".
#
# Leave blank once the merchant account is fully live, and each payer's own
# address is used instead — falling back to the platform contact address if
# theirs is missing or undeliverable.
PAYNOW_AUTH_EMAIL=""
